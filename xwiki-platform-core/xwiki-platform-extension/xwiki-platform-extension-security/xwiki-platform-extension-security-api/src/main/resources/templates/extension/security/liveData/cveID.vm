#foreach($index in $notIgnoredCVEsIndex)
<a href="$cveLinks[$index]">$cveIds[$index]</a>&nbsp;($cveCVSS[$index])<br>
#end
<div class="xHint">
  #foreach($index in $ignoredCVEsIndex)
    #set ($cveId = $cveIds[$index])
